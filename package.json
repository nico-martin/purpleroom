{
  "name": "green-room",
  "version": "0.0.1",
  "private": true,
  "description": "Trusted speaker intel among friends",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "db:migrate": "php api/db/migrate.php",
    "test:api": "node scripts/test-api.mjs",
    "test:ui": "playwright test",
    "test:deploy": "node --test scripts/test-production-config.mjs",
    "test:logos": "node scripts/test-logos.mjs",
    "test:editions": "node scripts/test-editions.mjs"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "latest",
    "@trivago/prettier-plugin-sort-imports": "latest",
    "@types/node": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.0",
    "vite": "latest"
  }
}
